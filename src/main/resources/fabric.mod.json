{
  "schemaVersion": 1,
  "id": "diggusmaximus",
  "version": "${version}",
  "name": "Diggus Maximus",
  "description": "Mine ores more better!",
  "authors": [
    "kyrptonaught"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/diggus-maximus",
    "sources": "https://github.com/kyrptonaught/DiggusMaximus"
  },
  "license": "MIT",
  "icon": "assets/diggusmaximus/icon.png",
  "environment": "*",
  "mixins": [
    {
      "config": "diggusmaximus.mixins.json"
    },
    {
      "config": "diggusmaximus.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "net.kyrptonaught.diggusmaximus.DiggusMaximusMod"
    ],
    "client": [
      "net.kyrptonaught.diggusmaximus.DiggusMaximusClientMod"
    ],
    "modmenu": [
      "net.kyrptonaught.diggusmaximus.config.modmenu.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": ">=20.0.1"
  }
}
